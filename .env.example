# Copy this file to .env and fill it in. Never commit the real .env.

# Meta Model API key, used to read payment screenshots.
# Create one at https://dev.meta.ai → API keys (sign in with your Meta account).
META_MODEL_API_KEY=

# Long random string that protects logins and the saved WhatsApp tokens.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If you leave it empty, one is created in instance/secret_key on first run.
# Changing it later logs everyone out and you must re-enter WhatsApp tokens.
SECRET_KEY=

# The public https address of this app once it's online (needed for WhatsApp).
# Example: https://payverify.example.com
PUBLIC_BASE_URL=

# Set to 1 when running behind a proxy or tunnel (ngrok, Render, Railway, Cloudflare Tunnel, nginx).
BEHIND_PROXY=0

# Who can create accounts.
ALLOW_SIGNUPS=1
# If set, new accounts need this invite code. Recommended once the app is public.
SIGNUP_CODE=

# Optional: which Meta model reads screenshots, and how hard it thinks
# (minimal, low, medium, high, xhigh). Don't use a "-contributor" model:
# Meta trains on those requests, and these are your customers' payments.
# PAYVERIFY_AI_MODEL=muse-spark-1.3
# PAYVERIFY_AI_EFFORT=low

# Optional: storage. Defaults to SQLite and files in ./instance
# DATABASE_URL=sqlite:////data/payverify.db
# INSTANCE_DIR=/data
# MAX_UPLOAD_MB=15
# WHATSAPP_GRAPH_VERSION=v25.0
